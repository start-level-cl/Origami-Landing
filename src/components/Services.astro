---
import { Sparkles, Gift, Palette, HeartHandshake, Check, MessageCircle, ArrowUpRight } from '@lucide/astro';
import { servicesData } from '../data/services';
import { siteConfig } from '../config/site.config';

const getServiceIcon = (iconName: string) => {
  switch (iconName) {
    case 'Gift':
      return Gift;
    case 'Palette':
      return Palette;
    case 'HeartHandshake':
      return HeartHandshake;
    default:
      return Sparkles;
  }
};
---

<section
  id="servicios"
  aria-labelledby="services-heading"
  class="services-section scroll-mt-16 sm:scroll-mt-20 py-20 sm:py-28 bg-origami-surface-sheet border-b border-origami-crease-line relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="fold-tag fold-tag-terracotta mb-4">
        <Sparkles class="w-3.5 h-3.5 text-origami-terracotta-600" />
        <span>Nuestras Creaciones</span>
      </div>
      <h2
        id="services-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-origami-ink-900 font-display"
      >
        Diseños y origamis para cada momento
      </h2>
      <p class="mt-4 text-base sm:text-lg text-origami-ink-600 leading-relaxed">
        Desde piezas individuales para decorar tu rincón favorito hasta pedidos personalizados y recuerdos para grandes celebraciones.
      </p>
    </div>

    <!-- Grid de 4 Servicios Destacados con Estilo de Pliego Plegado -->
    <div class="services-composition mt-14 grid grid-cols-1 md:grid-cols-2 gap-8">
      {servicesData.map((service, index) => {
        const IconComponent = getServiceIcon(service.iconName);
        const serviceWhatsappUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(`Hola Origami, me interesa consultar por el servicio de ${service.title}.`)}`;
        
        return (
          <article class={`service-sheet paper-sheet paper-sheet-hover p-8 flex flex-col justify-between group relative service-sheet-${index + 1}`}>
            
            <!-- Franja sutil de pliegue superior en terracota -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-origami-terracotta-600"></div>

            <div>
              <div class="flex items-start justify-between gap-4">
                <div class="w-12 h-12 bg-origami-surface-warm border border-origami-crease-line text-origami-terracotta-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform shadow-paper-flat">
                  <IconComponent class="w-6 h-6" />
                </div>
                <div class="fold-tag fold-tag-neutral">
                  {service.tag}
                </div>
              </div>

              <h3 class="mt-6 text-2xl font-bold text-origami-ink-900 font-display group-hover:text-origami-terracotta-700 transition-colors">
                {service.title}
              </h3>

              <p class="mt-2 text-sm font-semibold text-origami-terracotta-700">
                {service.shortDescription}
              </p>

              <p class="mt-3 text-sm text-origami-ink-600 leading-relaxed">
                {service.fullDescription}
              </p>

              <!-- Lista de Características -->
              <div class="mt-6 pt-6 border-t border-origami-crease-line">
                <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-origami-ink-400 mb-3 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 bg-origami-terracotta-500"></span>
                  Incluye y destaca:
                </h4>
                <ul class="space-y-2.5">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-origami-ink-700">
                      <div class="w-4 h-4 bg-origami-terracotta-100 text-origami-terracotta-700 flex items-center justify-center shrink-0 mt-0.5 border border-origami-terracotta-300">
                        <Check class="w-3 h-3" />
                      </div>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Bloque 'Ideal para' con estilo pliego secundario -->
              <div class="mt-6 p-3.5 bg-origami-surface-warm border border-origami-crease-line text-xs text-origami-ink-700">
                <strong class="text-origami-ink-900">Recomendado para:</strong> {service.idealFor}
              </div>
            </div>

            <!-- Botones de Acción -->
            <div class="mt-8 pt-6 border-t border-origami-crease-line flex items-center justify-between gap-4 flex-wrap">
              <a
                href={serviceWhatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-bold text-white bg-origami-forest-700 hover:bg-origami-forest-800 transition-colors shadow-paper-flat hover:shadow-paper-lift focus-visible:ring-2 focus-visible:ring-origami-forest-700"
              >
                <MessageCircle class="w-4 h-4" />
                <span>Consultar por WhatsApp</span>
              </a>

              <a
                href="#contacto"
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-origami-ink-900 hover:text-origami-terracotta-600 transition-colors px-3 py-2 hover:bg-origami-surface-warm"
              >
                <span>Hacer Pedido</span>
                <ArrowUpRight class="w-4 h-4 text-origami-terracotta-600" />
              </a>
            </div>

          </article>
        );
      })}
    </div>

  </div>
</section>
