---
import { Sparkles, Gift, Palette, HeartHandshake, Check, MessageCircle, ArrowUpRight } from '@lucide/astro';
import { servicesData } from '../data/services';
import { siteConfig } from '../config/site.config';

const getServiceIcon = (iconName: string) => {
  switch (iconName) {
    case 'Gift':
      return Gift;
    case 'Palette':
      return Palette;
    case 'HeartHandshake':
      return HeartHandshake;
    default:
      return Sparkles;
  }
};
---

<section
  id="servicios"
  aria-labelledby="services-heading"
  class="scroll-mt-16 sm:scroll-mt-20 py-20 sm:py-28 bg-white border-b border-origami-cream-200/80 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="origami-tag origami-tag-rose mb-4">
        <Sparkles class="w-3.5 h-3.5 text-origami-rose-700" />
        <span>Nuestras Creaciones</span>
      </div>
      <h2
        id="services-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-origami-slate-900 font-serif"
      >
        Diseños y origamis para cada momento
      </h2>
      <p class="mt-4 text-base sm:text-lg text-origami-slate-600 leading-relaxed">
        Desde piezas individuales para decorar tu rincón favorito hasta pedidos personalizados y recuerdos para grandes celebraciones.
      </p>
    </div>

    <!-- Grid de 4 Servicios Destacados con Estilo de Hoja Doblada -->
    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-8">
      {servicesData.map((service) => {
        const IconComponent = getServiceIcon(service.iconName);
        const serviceWhatsappUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(`Hola Origami, me interesa consultar por el servicio de ${service.title}.`)}`;
        
        return (
          <article class="paper-card paper-card-hover paper-fold-corner p-8 flex flex-col justify-between group">
            
            <!-- Franja facetada decorativa que simula pliegue de color superior -->
            <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-origami-rose-300 via-origami-lavender-300 to-origami-cream-300"></div>

            <div>
              <div class="flex items-start justify-between gap-4">
                <div class="w-14 h-14 rounded-2xl bg-origami-cream-100 border border-origami-cream-300 text-origami-rose-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform shadow-xs">
                  <IconComponent class="w-7 h-7" />
                </div>
                <div class="origami-tag origami-tag-lavender mr-6">
                  {service.tag}
                </div>
              </div>

              <h3 class="mt-6 text-2xl font-bold text-origami-slate-900 font-serif group-hover:text-origami-rose-700 transition-colors">
                {service.title}
              </h3>

              <p class="mt-2 text-sm font-semibold text-origami-rose-700">
                {service.shortDescription}
              </p>

              <p class="mt-3 text-sm text-origami-slate-600 leading-relaxed">
                {service.fullDescription}
              </p>

              <!-- Lista de Características en Bloque Texturado -->
              <div class="mt-6 pt-6 border-t border-origami-cream-200">
                <h4 class="text-xs font-bold uppercase tracking-wider text-origami-slate-700 mb-3 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-origami-rose-400"></span>
                  Incluye y destaca:
                </h4>
                <ul class="space-y-2.5">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-origami-slate-700">
                      <div class="w-4 h-4 rounded-full bg-origami-rose-100 text-origami-rose-700 flex items-center justify-center shrink-0 mt-0.5 border border-origami-rose-200">
                        <Check class="w-3 h-3" />
                      </div>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Bloque 'Ideal para' con estilo nota de papel adherida -->
              <div class="mt-6 p-3.5 rounded-xl bg-origami-cream-50/90 border border-origami-cream-300 text-xs text-origami-slate-700 shadow-xs">
                <strong class="text-origami-slate-900">Recomendado para:</strong> {service.idealFor}
              </div>
            </div>

            <!-- Botones de Acción -->
            <div class="mt-8 pt-6 border-t border-origami-cream-200 flex items-center justify-between gap-4 flex-wrap">
              <a
                href={serviceWhatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-bold text-white bg-emerald-700 hover:bg-emerald-600 rounded-xl transition-colors shadow-xs"
              >
                <MessageCircle class="w-4 h-4" />
                Consultar por WhatsApp
              </a>

              <a
                href="#contacto"
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-origami-slate-800 hover:text-origami-rose-600 transition-colors px-3 py-2 rounded-xl hover:bg-origami-rose-50"
              >
                <span>Hacer Pedido</span>
                <ArrowUpRight class="w-4 h-4" />
              </a>
            </div>

          </article>
        );
      })}
    </div>

  </div>
</section>
