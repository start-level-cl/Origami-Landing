---
import { Sparkles, Info, ChevronDown, MessageCircle } from '@lucide/astro';
import { faqData } from '../data/faq';
import { siteConfig } from '../config/site.config';

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent('Hola Origami, tengo una consulta sobre sus creaciones.')}`;
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="faq-section scroll-mt-16 sm:scroll-mt-20 py-20 sm:py-28 bg-origami-surface-sheet border-b border-origami-crease-line relative"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="fold-tag fold-tag-neutral mb-4">
        <Sparkles class="w-3.5 h-3.5 text-origami-terracotta-600" />
        <span>Respuestas Claras</span>
      </div>
      <h2
        id="faq-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-origami-ink-900 font-display"
      >
        Preguntas Frecuentes
      </h2>
      <p class="mt-4 text-base sm:text-lg text-origami-ink-600 leading-relaxed">
        Todo lo que necesitas saber sobre compras, personalización, tiempos y entregas antes de realizar tu pedido.
      </p>
    </div>

    <!-- Lista de Preguntas con Acordeón Exclusivo y Animación Fluida -->
    <div class="space-y-3.5" id="faq-accordion-container">
      {faqData.map((faq, index) => (
        <div
          class={`faq-item faq-sheet group paper-sheet transition-all duration-200 overflow-hidden hover:border-origami-terracotta-400 ${index === 0 ? 'is-open' : ''}`}
        >
          <button
            type="button"
            id={`faq-btn-${index}`}
            aria-expanded={index === 0 ? 'true' : 'false'}
            aria-controls={`faq-panel-${index}`}
            class="faq-trigger w-full flex items-center justify-between p-5 sm:p-6 cursor-pointer select-none text-left font-bold text-origami-ink-900 hover:text-origami-terracotta-700 transition-colors focus-visible:ring-2 focus-visible:ring-origami-terracotta-600"
          >
            <span class="text-base sm:text-lg flex items-center gap-3 pr-4 font-display">
              <Info class="w-5 h-5 text-origami-terracotta-600 shrink-0" />
              {faq.question}
            </span>
            <ChevronDown class="faq-chevron w-5 h-5 text-origami-ink-400 shrink-0 transition-transform duration-200" />
          </button>
          
          <div
            id={`faq-panel-${index}`}
            role="region"
            aria-labelledby={`faq-btn-${index}`}
            class="faq-content-wrapper"
          >
            <div class="overflow-hidden">
              <div class="faq-answer-sheet px-6 pb-6 pt-3 text-sm sm:text-base text-origami-ink-600 leading-relaxed bg-origami-surface-warm/40">
                {faq.answer}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner de Dudas Adicionales -->
    <div class="mt-12 p-6 sm:p-8 bg-origami-surface-warm border border-origami-crease-line flex flex-col sm:flex-row items-center justify-between gap-6 shadow-paper-sheet">
      <div class="text-center sm:text-left">
        <h3 class="text-base sm:text-lg font-bold text-origami-ink-900 font-display">
          ¿Tienes una pregunta diferente o un diseño especial?
        </h3>
        <p class="text-xs sm:text-sm text-origami-ink-600 mt-1">
          Escríbenos directamente por WhatsApp y te orientamos al instante de forma personalizada.
        </p>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 bg-origami-forest-700 hover:bg-origami-forest-800 text-white font-bold text-xs sm:text-sm transition-all shadow-paper-flat hover:shadow-paper-lift shrink-0 focus-visible:ring-2 focus-visible:ring-origami-forest-700"
      >
        <MessageCircle class="w-4 h-4" />
        <span>Escribir a WhatsApp</span>
      </a>
    </div>

  </div>
</section>

<script>
  // Control de acordeón exclusivo con animación CSS Grid continua y fluida
  const accordionContainer = document.getElementById('faq-accordion-container');
  if (accordionContainer) {
    const items = accordionContainer.querySelectorAll<HTMLElement>('.faq-item');

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Cerrar todos los items (garantizando exclusividad con animación suave simultánea)
        items.forEach((otherItem) => {
          const otherTrigger = otherItem.querySelector<HTMLButtonElement>('.faq-trigger');
          otherItem.classList.remove('is-open');
          if (otherTrigger) {
            otherTrigger.setAttribute('aria-expanded', 'false');
          }
        });

        // Si el elemento clickeado estaba cerrado, abrirlo con animación fluida
        if (!isOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
</script>
