---
import { Search, Sparkles, MessageCircle, PackageCheck, Clock } from '@lucide/astro';
import { processSteps } from '../data/process';
import { siteConfig } from '../config/site.config';

const getProcessIcon = (iconName: string) => {
  switch (iconName) {
    case 'Search':
      return Search;
    case 'Sparkles':
      return Sparkles;
    case 'MessageCircle':
      return MessageCircle;
    default:
      return PackageCheck;
  }
};

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent('Hola Origami, me gustaría consultar por un pedido.')}`;
---

<section
  id="proceso"
  aria-labelledby="process-heading"
  class="scroll-mt-16 sm:scroll-mt-20 py-20 sm:py-28 bg-origami-surface-base border-b border-origami-crease-line relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="fold-tag fold-tag-neutral mb-4">
        <Sparkles class="w-3.5 h-3.5 text-origami-terracotta-600" />
        <span>Paso a Paso</span>
      </div>
      <h2
        id="process-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-origami-ink-900 font-display"
      >
        ¿Cómo realizar tu pedido en Origami?
      </h2>
      <p class="mt-4 text-base sm:text-lg text-origami-ink-600 leading-relaxed">
        Un proceso sencillo, transparente y personalizado para que recibas exactamente la creación que sueñas.
      </p>
    </div>

    <!-- Grid de 4 Pasos con Estilo de Fichas de Papel -->
    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {processSteps.map((step) => {
        const IconComponent = getProcessIcon(step.iconName);
        return (
          <div class="paper-sheet paper-sheet-hover p-6 flex flex-col justify-between group">
            
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-bold font-mono text-origami-ink-400 group-hover:text-origami-terracotta-600 transition-colors">
                  {step.number}
                </span>
                <div class="w-10 h-10 bg-origami-surface-warm border border-origami-crease-line text-origami-terracotta-700 flex items-center justify-center shadow-xs">
                  <IconComponent class="w-5 h-5" />
                </div>
              </div>

              <h3 class="text-lg font-bold text-origami-ink-900 font-display">
                {step.title}
              </h3>

              <p class="mt-2 text-xs sm:text-sm text-origami-ink-600 leading-relaxed">
                {step.description}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-origami-crease-line text-xs font-mono font-bold text-origami-forest-800 bg-origami-forest-50 p-2.5 border border-origami-forest-200">
              ✓ {step.highlight}
            </div>

          </div>
        );
      })}
    </div>

    <!-- Banner de Atención Directa -->
    <div class="mt-12 max-w-4xl mx-auto bg-origami-surface-sheet p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 shadow-paper-sheet border border-origami-crease-line">
      <div class="w-14 h-14 bg-origami-forest-100 text-origami-forest-800 flex items-center justify-center shrink-0 border border-origami-forest-300">
        <Clock class="w-7 h-7" />
      </div>
      <div class="flex-1 text-center sm:text-left">
        <h4 class="text-base sm:text-lg font-bold text-origami-ink-900 font-display">
          Atención continua y asesoría personalizada
        </h4>
        <p class="mt-1 text-xs sm:text-sm text-origami-ink-600">
          Estamos disponibles <strong>{siteConfig.contact.openingHours}</strong> para responder preguntas, acordar fechas de entrega y coordinar despachos a todo Santiago y regiones.
        </p>
      </div>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 bg-origami-forest-700 hover:bg-origami-forest-800 text-white text-xs sm:text-sm font-bold transition-all shadow-paper-flat hover:shadow-paper-lift shrink-0 focus-visible:ring-2 focus-visible:ring-origami-forest-700"
      >
        <MessageCircle class="w-4 h-4" />
        <span>Conversar por WhatsApp</span>
      </a>
    </div>

  </div>
</section>
