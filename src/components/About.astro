---
import { Sparkles, Heart, Scissors, MessageCircle, PackageCheck } from '@lucide/astro';
import { siteConfig } from '../config/site.config';

const pillars = [
  {
    title: 'Pasión por el Detalle',
    description: 'Cada figura se pliega minuciosamente a mano, cuidando la simetría, la tensión del papel y la prolijidad en cada ángulo.',
    icon: Scissors,
    tag: 'Técnica & Paciencia',
  },
  {
    title: 'Materiales Seleccionados',
    description: 'Utilizamos papeles especiales de origami (Kami, Washi y cartulinas de fibra) con textura suave, resistencia y colores duraderos.',
    icon: Sparkles,
    tag: 'Papeles Washi & Kami',
  },
  {
    title: 'Personalización Total',
    description: 'Adaptamos colores, tamaños, combinaciones y presentaciones para que tu obsequio o decoración sea 100% fiel a tu estilo.',
    icon: Heart,
    tag: 'Paletas a Elección',
  },
  {
    title: 'Coordinación Cercana',
    description: 'Te atendemos directamente por WhatsApp de 08:00 a 22:00 hrs para resolver consultas, sugerir combinaciones y coordinar tu entrega.',
    icon: MessageCircle,
    tag: 'Trato Humano',
  },
];
---

<section
  id="nosotros"
  aria-labelledby="about-heading"
  class="scroll-mt-16 sm:scroll-mt-20 py-20 sm:py-28 bg-origami-cream-50 border-b border-origami-cream-200/80 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna de Narrativa y Filosofía -->
      <div class="lg:col-span-6 flex flex-col items-start">
        <div class="origami-tag origami-tag-lavender mb-4">
          <Sparkles class="w-3.5 h-3.5 text-origami-lavender-700" />
          <span>Nuestra Historia & Pasión</span>
        </div>

        <h2
          id="about-heading"
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-origami-slate-900 leading-tight font-serif"
        >
          El arte de doblar el papel para <span class="text-origami-rose-600">crear momentos eternos</span>
        </h2>

        <p class="mt-6 text-base sm:text-lg text-origami-slate-600 leading-relaxed">
          En <strong>{siteConfig.brand.name}</strong> creemos que un simple pliego de papel puede transformarse en una expresión profunda de afecto, belleza y significado. Nuestra labor combina la tradición milenaria del origami con una sensibilidad moderna orientada al diseño decorativo y los obsequios significativos.
        </p>

        <p class="mt-4 text-base text-origami-slate-600 leading-relaxed">
          No producimos en serie: cada pieza es el resultado de tiempo, paciencia y destreza artesanal. Ya sea una grulla solitaria que lleva un deseo de paz o un arreglo floral completo para ambientar tu hogar, ponemos nuestro corazón en cada doblez.
        </p>

        <!-- Badge de Sello Artesanal con efecto de papel cosido -->
        <div class="mt-8 p-4 rounded-2xl bg-white border border-origami-cream-300 shadow-paper flex items-center gap-4 w-full sm:w-auto relative overflow-hidden paper-fold-corner">
          <div class="w-12 h-12 rounded-xl bg-origami-rose-100 border border-origami-rose-200 text-origami-rose-700 flex items-center justify-center shrink-0">
            <PackageCheck class="w-6 h-6" />
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-origami-slate-500 block">
              Sello & Compromiso Artesanal
            </span>
            <span class="text-sm font-bold text-origami-slate-900">
              Hecho a mano en Santiago con envíos coordinados
            </span>
          </div>
        </div>

      </div>

      <!-- Grid de 4 Pilares con Esquinas de Papel Dobladas -->
      <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {pillars.map((pillar) => (
          <div class="paper-card paper-card-hover paper-fold-corner p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-11 h-11 rounded-xl bg-origami-cream-100 text-origami-slate-800 flex items-center justify-center border border-origami-cream-300 shadow-xs">
                  <pillar.icon class="w-5 h-5 text-origami-rose-600" />
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-origami-slate-500 bg-origami-cream-100 px-2 py-0.5 rounded-md border border-origami-cream-200">
                  {pillar.tag}
                </span>
              </div>
              
              <h3 class="text-base sm:text-lg font-bold text-origami-slate-900 font-serif">
                {pillar.title}
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-origami-slate-600 leading-relaxed">
                {pillar.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
