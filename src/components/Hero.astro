---
import { Sparkles, MessageCircle, Heart, ShieldCheck, ArrowRight, Layers } from '@lucide/astro';
import { siteConfig } from '../config/site.config';

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(siteConfig.contact.whatsappDefaultMessage)}`;
---

<section
  id="inicio"
  aria-labelledby="hero-heading"
  class="hero-section relative overflow-hidden py-16 sm:py-24 lg:py-28 bg-origami-surface-base border-b border-origami-crease-line"
>
  <!-- Líneas sutiles de cuadrícula geométrica de plegado -->
  <div class="hero-fold-map absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="hero-composition grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Contenido Principal y CTAs -->
      <div class="hero-copy-sheet lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Badge de Taller en Terracota Suave -->
        <div class="fold-tag fold-tag-terracotta mb-6">
          <Sparkles class="w-3.5 h-3.5 text-origami-terracotta-600 shrink-0" />
          <span>{siteConfig.brand.name} · {siteConfig.brand.slogan}</span>
        </div>

        <!-- Único H1 de la One Page -->
        <h1
          id="hero-heading"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-origami-ink-900 leading-[1.12] font-display"
        >
          Creaciones de papel <span class="text-origami-terracotta-600 relative inline-block">
            hechas a mano
            <span class="absolute -bottom-1 left-0 w-full h-1 bg-origami-terracotta-400 opacity-60"></span>
          </span> para regalar, decorar y sorprender
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-origami-ink-600 leading-relaxed max-w-2xl">
          Descubre el encanto del origami tradicional y moderno. Cada pliegue está confeccionado con dedicación para crear figuras decorativas, sets de regalo memorables y pedidos personalizados para tus ocasiones especiales.
        </p>

        <!-- Botones de Acción -->
        <div class="mt-8 flex flex-wrap gap-4 w-full sm:w-auto items-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-base font-bold text-white bg-origami-forest-700 hover:bg-origami-forest-800 transition-all shadow-paper-flat hover:shadow-paper-lift focus-visible:ring-2 focus-visible:ring-origami-forest-700"
          >
            <MessageCircle class="w-5 h-5 shrink-0" />
            <span>Escribir por WhatsApp</span>
          </a>

          <a
            href="#contacto"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-base font-bold text-origami-ink-900 bg-origami-surface-sheet hover:bg-origami-surface-warm border border-origami-crease-line transition-all shadow-paper-flat hover:shadow-paper-lift focus-visible:ring-2 focus-visible:ring-origami-terracotta-600"
          >
            <span>Realizar Pedido</span>
            <ArrowRight class="w-4 h-4 text-origami-terracotta-600" />
          </a>
        </div>

        <!-- Diferenciales Rápidos en Tiras de Papel Técnico -->
        <div class="hero-proof-strip mt-10 pt-8 border-t border-origami-crease-line grid grid-cols-1 sm:grid-cols-3 gap-4 w-full">
          <div class="hero-proof-sheet flex items-center gap-3 bg-origami-surface-sheet p-3 border border-origami-crease-line shadow-paper-flat">
            <div class="w-8 h-8 bg-origami-terracotta-100 text-origami-terracotta-700 flex items-center justify-center shrink-0 border border-origami-terracotta-300">
              <Heart class="w-4 h-4" />
            </div>
            <span class="text-xs sm:text-sm font-bold text-origami-ink-900">100% Hecho a Mano</span>
          </div>

          <div class="hero-proof-sheet flex items-center gap-3 bg-origami-surface-sheet p-3 border border-origami-crease-line shadow-paper-flat">
            <div class="w-8 h-8 bg-origami-surface-warm text-origami-ink-700 flex items-center justify-center shrink-0 border border-origami-crease-line">
              <Sparkles class="w-4 h-4 text-origami-terracotta-600" />
            </div>
            <span class="text-xs sm:text-sm font-bold text-origami-ink-900">Diseños a Medida</span>
          </div>

          <div class="hero-proof-sheet flex items-center gap-3 bg-origami-surface-sheet p-3 border border-origami-crease-line shadow-paper-flat">
            <div class="w-8 h-8 bg-origami-forest-100 text-origami-forest-800 flex items-center justify-center shrink-0 border border-origami-forest-300">
              <ShieldCheck class="w-4 h-4" />
            </div>
            <span class="text-xs sm:text-sm font-bold text-origami-ink-900">Empaque Protegido</span>
          </div>
        </div>

      </div>

      <!-- Tarjeta Visual Destacada (Pliego Frontal con Marco Passe-Partout) -->
      <div class="hero-visual-sheet lg:col-span-5 flex justify-center">
        <div class="hero-art-card folded-sheet w-full max-w-md bg-origami-surface-sheet p-6 sm:p-8 border border-origami-crease-line shadow-paper-sheet relative fold-notch-tr">
          
          <!-- Encabezado de la Ficha Técnica -->
          <div class="flex items-center justify-between border-b border-origami-crease-line pb-4">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 bg-origami-terracotta-500 border border-origami-terracotta-600"></span>
              <span class="w-2.5 h-2.5 bg-origami-forest-600 border border-origami-forest-700"></span>
              <span class="w-2.5 h-2.5 bg-origami-crease-line border border-origami-crease-dark"></span>
            </div>
            <span class="text-xs font-mono font-bold text-origami-ink-400 flex items-center gap-1">
              <Layers class="w-3.5 h-3.5 text-origami-terracotta-600" />
              FICHA · TALLER
            </span>
          </div>

          <!-- Passe-Partout de Papel con Obra -->
          <div class="mt-6 space-y-5">
            <div class="hero-image-sheet folded-sheet relative w-full h-48 bg-origami-surface-warm border border-origami-crease-line flex items-center justify-center p-4">
              
              <!-- Líneas técnicas de pliegue en marca de agua -->
              <img
                src={siteConfig.brand.logo}
                alt="Creación artesanal de Origami"
                class="max-h-full max-w-full object-contain relative z-10 drop-shadow-sm"
                loading="eager"
              />
            </div>

            <div>
              <div class="fold-tag fold-tag-terracotta">
                DISEÑO DESTACADO
              </div>
              <h2 class="mt-2 text-2xl font-bold text-origami-ink-900 font-display leading-snug">
                Grulla Tradicional & Flores de Papel
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-origami-ink-600 leading-relaxed">
                Plegados con papel artesanal de alta textura. Disponibles en sets de regalo individuales o por encargo especial en tus tonos favoritos.
              </p>
            </div>

            <div class="pt-3 border-t border-origami-crease-line flex items-center justify-between">
              <div>
                <span class="text-[11px] font-mono font-bold text-origami-ink-400 block uppercase">Coordinación</span>
                <span class="text-sm font-bold text-origami-ink-900">Directa por WhatsApp</span>
              </div>
              <a
                href="#servicios"
                class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-origami-ink-900 bg-origami-surface-warm hover:bg-origami-surface-base border border-origami-crease-line transition-colors shadow-paper-flat"
              >
                <span>Ver Catálogo</span>
                <ArrowRight class="w-3.5 h-3.5 text-origami-terracotta-600" />
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
