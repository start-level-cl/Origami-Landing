---
import { MessageCircle } from '@lucide/astro';
import { siteConfig } from '../config/site.config';

interface Props {
  phoneNumber?: string;
  defaultMessage?: string;
}

const {
  phoneNumber = siteConfig.contact.whatsappNumber,
  defaultMessage = siteConfig.contact.whatsappDefaultMessage,
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<aside aria-label="Contacto directo por WhatsApp" class="fixed bottom-6 right-6 z-50">
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escribir por WhatsApp a Origami"
    class="group flex items-center gap-3 bg-origami-forest-700 hover:bg-origami-forest-800 text-white p-3.5 sm:px-4 sm:py-3.5 border border-origami-forest-600 shadow-paper-float hover:shadow-paper-lift transition-all duration-200 transform hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-origami-forest-400"
  >
    <span class="relative flex h-3 w-3 sm:hidden">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-origami-forest-300 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-origami-forest-200"></span>
    </span>

    <MessageCircle class="w-6 h-6 text-white shrink-0" />
    
    <span class="hidden sm:inline font-bold text-sm tracking-wide">
      ¿Hablamos por WhatsApp?
    </span>
  </a>
</aside>
